# Optional host configuration. For a personal loopback install, the app can save the connection.
CALIO_PUBLIC_ORIGIN=http://127.0.0.1:4173
CALIO_PORT=4173
CALIO_AI_CONFIG_FILE=

# For private HTTPS, the reverse proxy authenticates the owner and overwrites
# X-Calio-Authenticated with this independent value.
CALIO_AUTH_PROXY_TOKEN=

# Optional server-managed connection. Leave disabled to configure from the app.
CALIO_AI_ENABLED=false
CALIO_AI_API_KEY=
CALIO_AI_BASE_URL=https://iranrouter.net/api/v1
CALIO_AI_MODEL=openai/gpt-6-luna
CALIO_AI_CALORIE_MODEL=perplexity/sonar
