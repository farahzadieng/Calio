{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "food_name": {
      "type": "string"
    },
    "variant": {
      "type": "string"
    },
    "unit": {
      "type": "string"
    },
    "grams_per_unit": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "ml_per_unit": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "range_low": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "range_high": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "range_unit": {
      "enum": [
        "g",
        "mL",
        null
      ]
    },
    "confidence": {
      "enum": [
        "high",
        "medium",
        "low"
      ]
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string",
            "format": "uri"
          },
          "title": {
            "type": "string"
          },
          "accessed_date": {
            "type": "string",
            "format": "date"
          },
          "basis": {
            "type": "string"
          },
          "tool_evidence_id": {
            "type": "string"
          },
          "nutrient_keys": {
            "type": "array",
            "items": {
              "enum": [
                "energy_kcal",
                "water_ml",
                "caffeine_mg",
                "protein_g",
                "carbohydrates_g",
                "total_fat_g",
                "dietary_sugar_g",
                "fiber_g",
                "saturated_fat_g",
                "monounsaturated_fat_g",
                "polyunsaturated_fat_g",
                "dietary_cholesterol_mg",
                "vitamin_a_ug",
                "thiamin_b1_mg",
                "riboflavin_b2_mg",
                "niacin_b3_mg",
                "pantothenic_acid_b5_mg",
                "vitamin_b6_mg",
                "biotin_b7_ug",
                "folate_b9_ug",
                "vitamin_b12_ug",
                "vitamin_c_mg",
                "vitamin_d_ug",
                "vitamin_e_mg",
                "vitamin_k_ug",
                "calcium_mg",
                "chloride_mg",
                "chromium_ug",
                "copper_mg",
                "iodine_ug",
                "iron_mg",
                "magnesium_mg",
                "manganese_mg",
                "molybdenum_ug",
                "phosphorus_mg",
                "potassium_mg",
                "selenium_ug",
                "sodium_mg",
                "zinc_mg"
              ]
            }
          }
        },
        "required": [
          "url",
          "title",
          "accessed_date",
          "basis",
          "tool_evidence_id",
          "nutrient_keys"
        ],
        "additionalProperties": false
      }
    },
    "requires_review": {
      "type": "boolean"
    },
    "status": {
      "enum": [
        "resolved",
        "estimated",
        "unresolved"
      ]
    }
  },
  "required": [
    "food_name",
    "variant",
    "unit",
    "grams_per_unit",
    "ml_per_unit",
    "range_low",
    "range_high",
    "range_unit",
    "confidence",
    "assumptions",
    "sources",
    "requires_review",
    "status"
  ],
  "additionalProperties": false
}
