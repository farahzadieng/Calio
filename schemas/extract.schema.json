{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "entry_id": {
            "type": "string"
          },
          "revision": {
            "type": "integer",
            "minimum": 1
          },
          "local_date": {
            "type": "string",
            "format": "date"
          },
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "item_id": {
                  "type": "string"
                },
                "name_fa": {
                  "type": "string"
                },
                "name_en": {
                  "type": "string"
                },
                "quantity": {
                  "type": [
                    "number",
                    "null"
                  ],
                  "minimum": 0
                },
                "unit": {
                  "type": "string"
                },
                "variant": {
                  "type": "string"
                },
                "preparation": {
                  "type": "string"
                },
                "brand": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "confidence": {
                  "enum": [
                    "high",
                    "medium",
                    "low"
                  ]
                },
                "assumptions": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "requires_review": {
                  "type": "boolean"
                },
                "review_reason": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              },
              "required": [
                "item_id",
                "name_fa",
                "name_en",
                "quantity",
                "unit",
                "variant",
                "preparation",
                "brand",
                "confidence",
                "assumptions",
                "requires_review",
                "review_reason"
              ],
              "additionalProperties": false
            }
          },
          "symptoms": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "unparsed_text": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "entry_id",
          "revision",
          "local_date",
          "items",
          "symptoms",
          "unparsed_text"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "entries"
  ],
  "additionalProperties": false
}
